generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  extensions = [pgvector(map: "vector")]
}
        

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String
  createdAt   DateTime @default(now())

  jobs        Job[]
}


model Resume {
  id           String   @id @default(uuid())
  jobId        String

  storagePath  String
  status       ResumeStatus @default(PENDING)

  uploadedAt   DateTime?
  createdAt    DateTime @default(now())
  batchId      String?
  content      String?

  batch        UploadBatch? @relation(fields: [batchId], references: [id])
  job          Job      @relation(fields: [jobId], references: [id])
  parsed       ParsedResume?
  results      ScreeningResult[]
  failures  BatchFailure[]
  embeddings   ResumeEmbedding[]
}


model UploadBatch {
  id              String        @id @default(uuid())
  jobId           String
  totalResumes    Int
  processedCount  Int           @default(0)
  failedCount     Int           @default(0)
  status          BatchStatus   @default(PROCESSING)
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  resumes         Resume[]
  failures        BatchFailure[]
}

model BatchFailure {
  id        String   @id @default(uuid())
  batchId   String
  resumeId  String
  reason    String
  createdAt DateTime @default(now())

  batch     UploadBatch @relation(fields: [batchId], references: [id])
  resume    Resume      @relation(fields: [resumeId], references: [id])
}

enum BatchStatus {
  PROCESSING
  COMPLETED
}

enum BucketType {
  SKILLS
  BIO
  EXPERIENCE
}

model ParsedResume {
  id         String   @id @default(uuid())
  resumeId   String   @unique
  rawText    String
  parsedJson Json
  createdAt  DateTime @default(now())

  resume     Resume   @relation(fields: [resumeId], references: [id])
}

model ResumeEmbedding {
  id         String     @id @default(uuid())
  resumeId   String
  bucket     BucketType
  text       String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime   @default(now())

  resume     Resume     @relation(fields: [resumeId], references: [id])
}

model ScreeningResult {
  id               String   @id @default(uuid())
  resumeId         String
  jobId            String
  skillScore       Float
  experienceScore  Float
  bioScore         Float
  finalScore       Float
  rerankedScore    Float?
  explanation      String?
  modelVersion     String
  createdAt        DateTime @default(now())

  resume           Resume   @relation(fields: [resumeId], references: [id])
  @@unique([resumeId, jobId])
}

model Evaluations {
  id         String   @id @default(uuid())
  jobId      String   
  rawText    String
  verdict    String
  createdAt  DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id])
}


enum ResumeStatus {
  PENDING
  UPLOADED
  PROCESSING    // ← new: atomic claim in flight
  PARSED
  EMBEDDED
  SCORED        // ← new: scored after embedding
  READY         // reranked
  DISQUALIFIED
  FAILED        // ← new: exhausted retries
}

enum JobStatus {
  PENDING
  PROCESSING      // at least one batch embedding
  EMBEDDING_DONE  // all embedded, awaiting trigger
  RANKING         // pipeline 2 running
  RANKED
  FAILED
}

model Job {
  id           String    @id @default(uuid())
  userId       String
  title        String
  overview     String?
  constraints  Json?
  createdAt    DateTime  @default(now())

  // ← replace resumeCount with these
  totalResumes     Int       @default(0)  // incremented per batch
  processedCount   Int       @default(0)  // mirror of DO counter
  failedCount      Int       @default(0)
  status           JobStatus @default(PENDING)
  scoringRequested Boolean   @default(false)

  skillsText          String?
  bioText             String?
  experienceText      String?
  skillsEmbedding     Unsupported("vector(1536)")?
  bioEmbedding        Unsupported("vector(1536)")?
  experienceEmbedding Unsupported("vector(1536)")?

  user        User          @relation(fields: [userId], references: [id])
  resumes     Resume[]
  evaluations Evaluations[]
}

model RerankChunkResult {
  id          String   @id @default(uuid())
  jobId       String
  chunkIndex  Int
  resumeId    String
  score       Float
  explanation String
  isAnchor    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([jobId, chunkIndex])
}