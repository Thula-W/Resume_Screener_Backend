generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  extensions = [pgvector(map: "vector")]
}
        

model User {
  id        String   @id
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  jobs      Job[]
  subscription Subscription?
  feedbacks    Feedback[]
  @@map("users")
}


model Resume {
  id           String   @id @default(uuid())
  jobId        String
  name         String?
  storagePath  String
  status       ResumeStatus @default(PENDING)

  uploadedAt   DateTime?
  createdAt    DateTime @default(now())
  batchId      String?
  content      String?
  attributes   Json?
  contactInfo  Json?
  retryCount   Int  @default(0)


  batch        UploadBatch? @relation(fields: [batchId], references: [id])
  job          Job      @relation(fields: [jobId], references: [id])
  parsed       ParsedResume?
  results      ScreeningResult[]
  failures  BatchFailure[]
  embeddings   ResumeEmbedding[]
}


model UploadBatch {
  id              String        @id @default(uuid())
  jobId           String
  totalResumes    Int
  processedCount  Int           @default(0)
  failedCount     Int           @default(0)
  status          BatchStatus   @default(PROCESSING)
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  resumes         Resume[]
  failures        BatchFailure[]
}

model BatchFailure {
  id        String   @id @default(uuid())
  batchId   String
  resumeId  String
  reason    String
  createdAt DateTime @default(now())

  batch     UploadBatch @relation(fields: [batchId], references: [id])
  resume    Resume      @relation(fields: [resumeId], references: [id])
}

enum BatchStatus {
  PROCESSING
  COMPLETED
}

enum BucketType {
  SKILLS
  BIO
  EXPERIENCE
}

model ParsedResume {
  id         String   @id @default(uuid())
  resumeId   String   @unique
  rawText    String
  parsedJson Json
  createdAt  DateTime @default(now())

  resume     Resume   @relation(fields: [resumeId], references: [id])
}

model ResumeEmbedding {
  id         String     @id @default(uuid())
  resumeId   String
  bucket     BucketType
  text       String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime   @default(now())
  text_tsvector Unsupported("tsvector")? @default(dbgenerated())

  @@index([text_tsvector], map: "idx_resume_embedding_fts", type: Gin)
  resume     Resume     @relation(fields: [resumeId], references: [id])
}

model ScreeningResult {
  id               String   @id @default(uuid())
  resumeId         String
  jobId            String
  skillScore       Float
  experienceScore  Float
  bioScore         Float
  finalScore       Float
  rerankedScore    Float?
  azendlyScore     Float?
  explanation      String?
  categoryScores   Json?
  modelVersion     String
  createdAt        DateTime @default(now())

  resume           Resume   @relation(fields: [resumeId], references: [id])
  @@unique([resumeId, jobId])
}

model Evaluations {
  id         String   @id @default(uuid())
  jobId      String   
  rawText    String
  verdict    String
  signal     String?
  createdAt  DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id])
}


enum ResumeStatus {
  PENDING
  UPLOADED
  PROCESSING    // ← new: atomic claim in flight
  PARSED
  EMBEDDED
  SCORED        // ← new: scored after embedding
  READY         // reranked
  DISQUALIFIED
  FAILED        // ← new: exhausted retries
}

enum JobStatus {
  PENDING
  PROCESSING      // at least one batch embedding
  SCORED         // all scored, awaiting trigger
  RANKING         // pipeline 2 running
  RANKED
  RERANKING
  RERANKED
  FAILED
}

model Job {
  id           String    @id @default(uuid())
  userId       String
  title        String
  overview     String?
  constraints  Json?
  signals      Json?
  createdAt    DateTime  @default(now())

  // ← replace resumeCount with these
  totalResumes     Int       @default(0)  // incremented per batch
  processedCount   Int       @default(0)  // mirror of DO counter
  failedCount      Int       @default(0)
  status           JobStatus @default(PENDING)
  scoringRequested Boolean   @default(false)

  skillsText          String?
  bioText             String?
  experienceText      String?
  skillsEmbedding     Unsupported("vector(1536)")?
  bioEmbedding        Unsupported("vector(1536)")?
  experienceEmbedding Unsupported("vector(1536)")?

  user        User          @relation(fields: [userId], references: [id])
  resumes     Resume[]
  evaluations Evaluations[]
}

model RerankChunkResult {
  id          String   @id @default(uuid())
  jobId       String
  chunkIndex  Int
  resumeId    String
  score       Float
  explanation String
  isAnchor    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([jobId, chunkIndex])
}


//---------------------------------------

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique       // "free" | "basic" | "pro"
  displayName   String                 // "Free", "Basic", "Pro"
  resumeLimit   Int                    // resumes processed per billing period
  rankingLimit  Int                    // ranking jobs per billing period
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique   // one active sub per user
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Payment fields — null for now, filled when PayHere is integrated
  payhereOrderId        String? @unique
  payhereSubscriptionId String? @unique
  payhereCustomerToken  String?
  installmentsPaid      Int     @default(0)
  cancelAtPeriodEnd     Boolean @default(false)
  cancelledAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan        Plan          @relation(fields: [planId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  usageLedger UsageLedger[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model UsageLedger {
  id             String   @id @default(uuid())
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  resumesUsed    Int      @default(0)
  rankingsUsed   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, periodStart])
  @@map("usage_ledgers")
}

model Feedback {
  id                String   @id @default(uuid())
  userId            String   
  rating            Int      
  feedback          String   
  company           String?  
  hiresPerMonth     Int
  avgResumesPerRole Int
  suggestions       String?  
  createdAt         DateTime @default(now())

  // Relation link: cascade deletes feedback if the user is deleted
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}